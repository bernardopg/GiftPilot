{
  "name": "giftpilot",
  "version": "3.0.0",
  "description": "Smart companion for SteamGifts: dark theme, filters, win odds and paced auto-entry.",
  "main": "js/background/service-worker.js",
  "scripts": {
    "lint": "eslint js tests scripts",
    "lint:fix": "eslint js tests scripts --fix",
    "format": "prettier --check \"**/*.{js,mjs,css,html,json}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,css,html,json}\"",
    "check": "npm run lint && npm run format",
    "test": "node --test tests/*.test.js",
    "metadata:check": "node scripts/check-metadata.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "verify": "npm run metadata:check && npm run i18n:check && npm test",
    "build": "npm run check && npm run verify && node scripts/build-extension.mjs",
    "package": "npm run build && node scripts/package-extension.mjs",
    "release": "npm run package"
  },
  "keywords": [
    "steamgifts",
    "giveaways",
    "browser-extension",
    "chrome-extension",
    "manifest-v3",
    "dark-theme"
  ],
  "author": "Bernardo Pinto Gomes (https://github.com/bernardopg)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bernardopg/AutoJoin-for-SteamGifts.git"
  },
  "bugs": {
    "url": "https://github.com/bernardopg/AutoJoin-for-SteamGifts/issues"
  },
  "homepage": "https://bernardopg.github.io/AutoJoin-for-SteamGifts/",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0 || ^24.0.0 || >=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
