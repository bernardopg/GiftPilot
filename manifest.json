{
  "manifest_version": 3,
  "name": "GiftPilot",
  "short_name": "GiftPilot",
  "version": "3.0.0",
  "description": "Smart companion for SteamGifts: dark theme, filters, win odds and paced auto-entry.",
  "homepage_url": "https://bernardopg.github.io/GiftPilot/",
  "default_locale": "en",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "GiftPilot",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "js/background/service-worker.js"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": [
        "*://www.steamgifts.com/",
        "*://www.steamgifts.com/giveaways/search?*",
        "*://www.steamgifts.com/game/*",
        "*://steamgifts.com/",
        "*://steamgifts.com/giveaways/search?*",
        "*://steamgifts.com/game/*"
      ],
      "css": ["css/site/widgets.css"],
      "js": [
        "js/core/i18n.js",
        "js/core/settings-store.js",
        "js/core/timing.js",
        "js/core/sg-request.js",
        "js/content/panel.js",
        "js/core/giveaway-parse.js",
        "js/core/autojoin-plan.js",
        "js/content/infinite-scroll.js",
        "js/core/steam-community.js",
        "js/content/steam-data.js",
        "js/content/rows.js",
        "js/content/page.js",
        "js/content/listing.js"
      ]
    },
    {
      "run_at": "document_start",
      "matches": ["*://www.steamgifts.com/*", "*://steamgifts.com/*"],
      "exclude_matches": [
        "*://www.steamgifts.com/",
        "*://www.steamgifts.com/giveaways/search?*",
        "*://www.steamgifts.com/game/*",
        "*://steamgifts.com/",
        "*://steamgifts.com/giveaways/search?*",
        "*://steamgifts.com/game/*"
      ],
      "css": ["css/site/widgets.css"],
      "js": [
        "js/core/i18n.js",
        "js/core/settings-store.js",
        "js/core/sg-request.js",
        "js/content/panel.js",
        "js/content/infinite-scroll.js",
        "js/content/page.js"
      ]
    }
  ],
  "options_ui": {
    "page": "html/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "notifications",
    "storage",
    "offscreen",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://www.steamgifts.com/*",
    "*://store.steampowered.com/*"
  ],
  "optional_host_permissions": ["*://steamcommunity.com/profiles/*"],
  "minimum_chrome_version": "116"
}
