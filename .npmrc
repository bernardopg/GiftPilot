# npm configuration - GiftPilot
# Keeps local installs aligned with the runtime declared in package.json.

# Fail fast when the active Node.js version is outside the supported range
# declared in package.json "engines".
engine-strict=true

# Never install from a lockfile that drifted from package.json.
package-lock=true

# Keep the install output focused on actionable problems.
fund=false
